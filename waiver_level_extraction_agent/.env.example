# Copy this file to ".env" (same folder) and replace the placeholders.
# Step-by-step instructions, with pictures, are in the setup PDF guide
# (section "Create your .env file"). Never commit ".env" - it is git-ignored.

# --- Google Cloud project (CHANGE THESE) -----------------------------------
# Your Google Cloud project ID (not the project name or number). Find it in
# the Google Cloud console: click the project picker at the top of the page,
# then copy the value in the "ID" column.
# PROJECT_ID and GOOGLE_CLOUD_PROJECT must be the SAME value: the pipeline
# scripts read PROJECT_ID, the adk web app reads GOOGLE_CLOUD_PROJECT.
PROJECT_ID=your-project-id
GOOGLE_CLOUD_PROJECT=your-project-id

# --- Vertex AI (usually leave as is) ---------------------------------------
# Sign in once with:  gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
LOCATION=us-central1

# --- Optional ---------------------------------------------------------------
# Cloud Storage bucket used to cache large PDFs for the services pipeline.
# Left unset, "<PROJECT_ID>-waiver-pdf-cache" is created on first use (the
# account needs permission to create buckets).
# CACHE_GCS_BUCKET=

# --- Data folders (relative to the project root; usually leave as is) ------
PDF_DIR=data/pdfs_267_latest
OUTPUT_DIR=data/outputs
LOG_DIR=data/logs
